# cursor-byok standalone config
# Copy to .env and edit. cursor-server.exe loads it automatically.

# Listen address. Use 0.0.0.0:PORT to allow LAN access.
CURSOR_LISTEN_ADDR=127.0.0.1:3000

# Frontend static files directory (relative to the exe).
CURSOR_CONSOLE_DIR=dist

# External API key (PROXY_ACCESS_KEY). Requests to /v1/chat/completions etc.
# must carry this key. Leave empty to disable external auth.
CURSOR_EXTERNAL_API_KEY=

# SQLite database path. Portable mode: keep it next to the exe.
CURSOR_DATABASE_URL=sqlite://./data/cursor-byok.db

# Log level
RUST_LOG=info
